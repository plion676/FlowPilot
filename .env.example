# 仅填写本地值；不要提交真实密钥。
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# DeepSeek OpenAI 兼容 API；Key 只能放在本地 .env/进程环境中，不能提交。
# Key 留空时，健康检查和基础 API 仍可用，但 /api/chat 会返回 LLM_NOT_CONFIGURED。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Agent API 与 MCP Server 共用的本地签名密钥（至少 32 字符）；不得提交真实值。
MCP_URL=http://127.0.0.1:3100/mcp/consultant
MCP_CALL_SECRET=

# 可选：精确 IP 地址白名单，Go 和 Agent 共用；默认仅运营顾问角色路径。
# MCP_ALLOWED_TARGETS='["http://127.0.0.1:3100/mcp/consultant"]'
# 可选：凭据引用不是密钥。只允许 MCP_CALL_SECRET 或 OPSPILOT_MCP_SECRET_*。
# MCP_CREDENTIAL_PROFILES='{"local":{"secret_env":"MCP_CALL_SECRET","endpoint_ids":["business"],"targets":["http://127.0.0.1:3100/mcp/consultant"]}}'
# 可选：部署身份明确所属角色；domains 仅控制连接内工具模块，不是 Endpoint 分类。
# MCP_ENDPOINT_DEFINITIONS='[{"id":"business","role_id":"consultant","path":"/mcp/consultant","domains":["crm","mes","knowledge","workflow"]}]'

# Agent API / MCP Server → Go：查询模拟数据和当前工具绑定。
BUSINESS_BASE_URL=http://127.0.0.1:8082/
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-token

# Go 模拟业务服务：只填本地专用 MySQL 库，密码不要提交。
BUSINESS_DATABASE_DSN=
BUSINESS_LISTEN_ADDR=127.0.0.1:8082
SEED_DATE=2026-09-30

# SOP RAG：独立的本地 Qdrant；MCP 调用 Agent 内部检索接口。
QDRANT_URL=http://127.0.0.1:6333
RAG_BASE_URL=http://127.0.0.1:8000/
# 国内官方镜像代理，可用于 infra/compose.rag.yaml。
# QDRANT_IMAGE=m.daocloud.io/docker.io/qdrant/qdrant:v1.17.0
# 开发模式后台回访 Worker；联调手动领取任务时设为 0。
TASK_WORKER_ENABLED=1
